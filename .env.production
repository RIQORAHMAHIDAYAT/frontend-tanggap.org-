# Base URL API Backend (Hostinger Production)
VITE_API_BASE_URL=https://api.tanggap.org/api

# Feature Toggle Mock Mode:
# 'false' = Terhubung ke Live Backend API (dengan graceful fallback otomatis)
# 'true'  = Rollback instan ke Full Mock Lokal (100% data statis/localStorage)
VITE_USE_MOCK=false

# Google OAuth 2.0 Client ID
VITE_GOOGLE_CLIENT_ID=354097984425-4gbg3j9e2jes4cl3cs39dr98kap2huqc.apps.googleusercontent.com
